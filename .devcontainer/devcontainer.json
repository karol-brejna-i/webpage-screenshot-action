// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/javascript-node
{
	"name": "GitHub Action Development - Webpage Screenshot",
	"build": {
		"dockerfile": "Dockerfile"
	},
	
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers-extra/features/yamllint:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "npm install",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.vscode-json",
				"redhat.vscode-yaml",
				"github.vscode-github-actions",
				"ms-vscode.test-adapter-converter",
				"orta.vscode-jest",
				"esbenp.prettier-vscode",
				"ms-vscode.vscode-eslint",
				"github.copilot"
			],
			"settings": {
				"editor.formatOnSave": true,
				"eslint.validate": ["javascript"],
				"jest.autoRun": "off"
			}
		}
	},

	// Mount the Docker socket for building and testing action containers
	"mounts": [
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
	],

	// Environment variables for GitHub Actions development
	"containerEnv": {
		"PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
		"PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium"
	},

	// Run as non-root user for security
	"remoteUser": "node"
}
